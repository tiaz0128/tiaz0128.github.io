---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <!-- 블로그 포스트 URL -->
  {% assign current_time = site.time | date: '%s' %}
  {% for post in site.posts %}
    {% assign post_time = post.ins_date | date: '%s' %}
    {% assign time_diff = current_time | minus: post_time %}
    {% assign days_since = time_diff | divided_by: 86400 %}
    
    <url>
      <loc>{{ site.url }}{{ post.url }}</loc>
      <lastmod>{{ post.upd_date | default: post.ins_date | date_to_xmlschema }}</lastmod>
      
      {% if days_since < 7 %}
        <changefreq>daily</changefreq>
        <priority>1.0</priority>
      {% elsif days_since < 30 %}
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
      {% else %}
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
      {% endif %}
    </url>
  {% endfor %}

  <!-- 프로필 링크 허브와 요약본 문서들. 링크트리를 대신하는 자리라 색인에 올린다. -->
  <url>
    <loc>{{ site.url }}/link/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  {% for doc in site.data.resources %}
    <url>
      <loc>{{ site.url }}/resources/{{ doc.slug }}.html</loc>
      <lastmod>{{ doc.date | date_to_xmlschema }}</lastmod>
      <changefreq>monthly</changefreq>
      <priority>0.8</priority>
    </url>
  {% endfor %}
</urlset>
